<Window x:Class="CountdownApp.SetDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustaw datę wydarzenia"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Padding="20">
    <Border CornerRadius="16"
            Background="White"
            Padding="20"
            BorderBrush="#FFE0E4EA"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="4"
                              Opacity="0.22"
                              Color="#220F2640"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Wybierz datę i godzinę"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"
                       Foreground="#203047"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Data" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#41536B"/>
                    <DatePicker x:Name="DateSelector"
                                Width="220"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Godzina" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#41536B"/>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="10"
                                BorderBrush="#FFE0E4EA"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <ListBox x:Name="HourList"
                                     Width="70"
                                     Height="160"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock Text=":" FontSize="24" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0"/>
                        <Border CornerRadius="10"
                                BorderBrush="#FFE0E4EA"
                                BorderThickness="1">
                            <ListBox x:Name="MinuteList"
                                     Width="70"
                                     Height="160"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Obraz lub animacja"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#41536B"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="MediaPathTextBox"
                             Width="260"
                             Margin="0,0,12,0"
                             TextWrapping="NoWrap"/>
                    <Button Content="Wybierz..."
                            Width="90"
                            Click="ChooseMediaButton_OnClick"/>
                    <Button Content="Wyczyść"
                            Width="80"
                            Margin="8,0,0,0"
                            Click="ClearMediaButton_OnClick"/>
                </StackPanel>
                <TextBlock Text="Zostaw puste, aby użyć domyślnej grafiki."
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Podpis pod grafiką"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#41536B"/>
                <TextBox x:Name="CaptionTextBox"
                         Width="360"
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Ikona przy dacie"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#41536B"/>
                <TextBox x:Name="IconTextBox"
                         Width="80"
                         MaxLength="4"
                         HorizontalContentAlignment="Center"
                         FontSize="20"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Width="100"
                        Margin="0,0,12,0"
                        Click="CancelButton_OnClick"/>
                <Button x:Name="ConfirmButton"
                        Content="Zapisz"
                        Width="120"
                        IsDefault="True"
                        Click="ConfirmButton_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>