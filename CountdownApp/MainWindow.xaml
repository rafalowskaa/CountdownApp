<Window x:Class="CountdownApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                Title="Countdown"
        Width="480"
        Height="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Margin="20" Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2"
                    CornerRadius="28"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1.5"
                    Padding="26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.2" Color="#AA0F2640"/>
                </Border.Effect>
            </Border>

            <StackPanel Grid.Column="0"
                        Margin="36,26,24,26"
                        VerticalAlignment="Center">
                <TextBlock Text="Do wydarzenia pozostało:" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="CountdownText"
                           Margin="0,8,0,6"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Background="#30FFFFFF" CornerRadius="16" Padding="12,8" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎄" FontSize="20" Margin="0,0,6,0"/>
                        <TextBlock x:Name="EventDateText"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Left">
                    <Button x:Name="SetDateBtn" Content="Ustaw datę..." Width="140" Click="SetDateBtn_Click"/>
                    <Button x:Name="AutostartBtn" Width="150" Click="AutostartBtn_Click" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Margin="12,0,4,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Canvas Grid.Row="0">
                    <Ellipse Width="160" Height="160" Fill="#33FFFFFF" Canvas.Left="40" Canvas.Top="4"/>
                    <Polygon Points="20,140 90,60 160,140" Fill="#66FFFFFF"/>
                    <Polygon Points="34,140 90,74 144,140" Fill="#88FFFFFF"/>

                    <Rectangle Width="80" Height="54" Fill="{StaticResource HouseWallColor}" RadiusX="10" RadiusY="10"
                               Canvas.Left="60" Canvas.Top="90"/>
                    <Polygon Points="50,102 100,60 150,102" Fill="{StaticResource HouseRoofColor}"/>
                    <Rectangle Width="14" Height="32" Fill="{StaticResource ChimneyAccentColor}" Canvas.Left="118" Canvas.Top="66"/>
                    <Rectangle Width="42" Height="28" Fill="{StaticResource WindowGlowColor}"
                               Canvas.Left="79" Canvas.Top="104" RadiusX="6" RadiusY="6"/>
                    <Rectangle Width="4" Height="28" Fill="#80FFFFFF" Canvas.Left="99" Canvas.Top="104"/>
                    <Rectangle Width="42" Height="4" Fill="#80FFFFFF" Canvas.Left="79" Canvas.Top="118"/>

                    <Ellipse Width="10" Height="10" Fill="#CCFFFFFF" Canvas.Left="30" Canvas.Top="24"/>
                    <Ellipse Width="6" Height="6" Fill="#CCFFFFFF" Canvas.Left="170" Canvas.Top="38"/>
                    <Ellipse Width="8" Height="8" Fill="#CCFFFFFF" Canvas.Left="136" Canvas.Top="18"/>
                    <Ellipse Width="7" Height="7" Fill="#CCFFFFFF" Canvas.Left="84" Canvas.Top="30"/>
                    <Ellipse Width="6" Height="6" Fill="#CCFFFFFF" Canvas.Left="122" Canvas.Top="52"/>
                </Canvas>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="Spokojny dom, ciepły komin i zimowa cisza." Style="{StaticResource CaptionTextStyle}" TextAlignment="Center"/>
                    <TextBlock Text="Pozostań na czasie i złap klimat chill house." Style="{StaticResource CaptionTextStyle}" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
