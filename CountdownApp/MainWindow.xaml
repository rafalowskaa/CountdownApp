<Window x:Class="CountdownApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown" Width="380" Height="160"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Topmost="True">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="Do wydarzenia pozostało:" FontSize="18" Margin="0,0,0,8"/>
            <TextBlock x:Name="CountdownText" FontSize="26" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right" >
                <Button x:Name="SetDateBtn" Content="Ustaw datę..." Width="110" Margin="0,0,8,0" Click="SetDateBtn_Click"/>
                <Button x:Name="AutostartBtn" Content="Autostart: włącz" Width="130" Click="AutostartBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
